[Unit]
Description=Capilora Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/capilora-current
EnvironmentFile=/etc/capilora/capilora.env
Environment=NODE_ENV=production
Environment=PORT=3142
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/capilora

[Install]
WantedBy=multi-user.target

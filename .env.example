# Local development uses .data/content.db and .data/uploads by default.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Production only: configure these in Vercel. Never copy production values
# into a local development environment or commit them to Git.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Optional local data directory:
# CMS_DATA_DIR=
# Set the admin password interactively with: pnpm admin:password
